{
  "name": "zibll-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/zibll-docs-mcp"
  ],
  "scripts": {
    "prebuild": "tsx scripts/prebuild.ts",
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "mcp": "node packages/zibll-docs-mcp/bin/zibll-docs-mcp.mjs",
    "mcp:prepare": "node scripts/generate-mcp-data.mjs",
    "mcp:check": "node scripts/check-mcp.mjs",
    "community:check": "node scripts/check-community.mjs",
    "pages:check": "node scripts/check-pages-export.mjs",
    "github:setup": "node scripts/setup-github.mjs",
    "test:navigation": "playwright test tests/docs-navigation.spec.ts",
    "start": "node scripts/serve-static.mjs out",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@orama/orama": "^3.1.16",
    "@orama/tokenizers": "^3.1.16",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.10.7",
    "fumadocs-mdx": "15.0.13",
    "fumadocs-ui": "16.10.7",
    "lucide-react": "^0.552.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.2",
    "baseline-browser-mapping": "^2.10.42",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
